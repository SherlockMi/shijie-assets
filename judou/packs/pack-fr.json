 "entries": [
  {
   "q": "你好",
   "aliases": [
    "您好"
   ],
   "variants": [
    {
     "content": "Bonjour.",
     "zh": "你好",
     "style": "正式",
     "register": "法国最标准的问候，进店、见面必说。不说会被认为没礼貌",
     "recommended": true
    },
    {
     "content": "Salut.",
     "zh": "你好",
     "style": "口语",
     "register": "熟人之间，也可用于告别。对陌生人用会显得轻慢",
     "recommended": false
    },
    {
     "content": "Bonsoir.",
     "zh": "你好",
     "style": "正式",
     "register": "傍晚六点以后用，进店、见面都合适",
     "recommended": false
    }
   ],
   "words": [
    {
     "surface": "bonjour",
     "zh": "日安、你好，白天用"
    },
    {
     "surface": "salut",
     "zh": "嗨（熟人），也用于告别"
    }
   ],
   "mistakes": [
    {
     "wrong": "Bonjour, comment allez-vous? — Ça va.",
     "why": "法语的 vous 是敬称，熟人之间用 tu 更自然",
     "right": "Bonjour, comment vas-tu ? — Ça va bien, merci."
    }
   ],
   "examples": [
    {
     "en": "Bonjour, je voudrais un café, s’il vous plaît.",
     "zh": "您好，我要一杯咖啡，谢谢。"
    },
    {
     "en": "Salut, ça va ?",
     "zh": "嗨，还好吗？"
    }
   ],
   "note": "在法国，进门不说 Bonjour 会被当成失礼，这比语法错误严重得多。Bonsoir 从傍晚开始用，不分正式与否。",
   "tags": [
    "日常生活",
    "口语"
   ]
  },
  {
   "q": "谢谢",
   "aliases": [
    "感谢"
   ],
   "variants": [
    {
     "content": "Merci.",
     "zh": "谢谢",
     "style": "口语",
     "register": "最常用。注意法语 merci 的重音在最后，别读成英语腔",
     "recommended": true
    },
    {
     "content": "Merci beaucoup.",
     "zh": "谢谢",
     "style": "正式",
     "register": "加强版，beaucoup 是很多。任何场合都合适",
     "recommended": false
    },
    {
     "content": "Je vous remercie.",
     "zh": "谢谢",
     "style": "正式",
     "register": "书面/正式致谢，邮件结尾常见。口语说略显拘谨",
     "recommended": false
    }
   ],
   "words": [
    {
     "surface": "merci",
     "zh": "谢谢"
    },
    {
     "surface": "beaucoup",
     "zh": "很、非常多"
    }
   ],
   "mistakes": [
    {
     "wrong": "Merci beaucoup à vous.",
     "why": "不算错但很生硬，口语里显多余",
     "right": "Merci beaucoup."
    }
   ],
   "examples": [
    {
     "en": "Merci beaucoup !",
     "zh": "非常感谢！"
    },
    {
     "en": "Merci beaucoup pour votre aide.",
     "zh": "非常感谢您的帮助。"
    }
   ],
   "note": "法语的 Merci 后面常接 pour + 名词（为某事道谢），这是中文母语者最常漏掉的结构。",
   "tags": [
    "日常生活",
    "口语"
   ]
  },
  {
   "q": "对不起",
   "aliases": [
    "抱歉",
    "不好意思"
   ],
   "variants": [
    {
     "content": "Pardon !",
     "zh": "对不起",
     "style": "口语",
     "register": "撞到人、借过时说，最轻。进地铁、挤人群就靠它",
     "recommended": true
    },
    {
     "content": "Excusez-moi.",
     "zh": "对不起",
     "style": "正式",
     "register": "对陌生人（vous 形式）说「打扰一下」，问路、叫服务员都用",
     "recommended": false
    },
    {
     "content": "Je suis désolé.",
     "zh": "对不起",
     "style": "正式",
     "register": "真做错事时用。女性说 désolée，要跟主语变性",
     "recommended": false
    },
    {
     "content": "Je vous prie de m’excuser.",
     "zh": "对不起",
     "style": "书面",
     "register": "书面/正式致歉，邮件或公文用。口语说像在念公文",
     "recommended": false
    }
   ],
   "words": [
    {
     "surface": "pardon",
     "zh": "抱歉/借过（最轻）"
    },
    {
     "surface": "désolé",
     "zh": "抱歉的（阴性 désolée）"
    }
   ],
   "mistakes": [
    {
     "wrong": "Excuse-moi, monsieur.",
     "why": "对陌生人用 tu 形式的 Excuse-moi 会显得随便，法国人对这个很敏感",
     "right": "Excusez-moi, monsieur."
    }
   ],
   "examples": [
    {
     "en": "Pardon, je peux passer ?",
     "zh": "抱歉，能让我过一下吗？"
    },
    {
     "en": "Excusez-moi, je cherche la gare.",
     "zh": "打扰一下，我在找火车站。"
    }
   ],
   "note": "法语道歉分两层：pardon 是「借过」，désolé 是「我错了」。用 pardon 道歉显得轻描淡写，用 désolé 借过又太重。",
   "tags": [
    "日常生活",
    "社交"
   ]
  },
  {
   "q": "再见",
   "aliases": [
    "拜拜",
    "回头见"
   ],
   "variants": [
    {
     "content": "Au revoir.",
     "zh": "再见",
     "style": "正式",
     "register": "标准道别，任何场合都安全。字面是「再见上帝」",
     "recommended": true
    },
    {
     "content": "Salut !",
     "zh": "再见",
     "style": "口语",
     "register": "熟人之间，既能打招呼也能道别。对长辈用会失礼",
     "recommended": false
    },
    {
     "content": "À bientôt.",
     "zh": "再见",
     "style": "口语",
     "register": "「很快见」，没有具体时间。比 au revoir 亲切",
     "recommended": false
    },
    {
     "content": "Bonne journée !",
     "zh": "再见",
     "style": "口语",
     "register": "道别时附赠的祝福，店员、同事天天说。晚上改 Bonne soirée",
     "recommended": false
    }
   ],
   "words": [
    {
     "surface": "au revoir",
     "zh": "再见（标准）"
    },
    {
     "surface": "salut",
     "zh": "嗨 / 拜（仅熟人）"
    }
   ],
   "mistakes": [
    {
     "wrong": "Bonne journée à vous aussi, salut !",
     "why": "一句里混用 vous 和 salut，正式与熟络打架，法语里很别扭",
     "right": "Bonne journée à vous aussi, au revoir !"
    }
   ],
   "examples": [
    {
     "en": "Au revoir, bonne journée !",
     "zh": "再见，祝您今天愉快！"
    },
    {
     "en": "Salut, à demain !",
     "zh": "拜，明天见！"
    }
   ],
   "note": "法国人道别几乎必带一句 Bonne journée / Bonne soirée。不说也不算错，但说了会立刻显得「懂规矩」。",
   "tags": [
    "日常生活",
    "社交"
   ]
  },
  {
   "q": "请再说一遍",
   "aliases": [
    "我没听清",
    "你说什么"
   ],
   "variants": [
    {
     "content": "Comment ?",
     "zh": "请再说一遍",
     "style": "口语",
     "register": "最常用的一词追问，语气别太重，否则像不满",
     "recommended": true
    },
    {
     "content": "Pouvez-vous répéter, s’il vous plaît ?",
     "zh": "请再说一遍",
     "style": "正式",
     "register": "最安全的完整句。对陌生人、上司都用这句",
     "recommended": false
    },
    {
     "content": "Je n’ai pas compris.",
     "zh": "请再说一遍",
     "style": "口语",
     "register": "「我没听懂」，比没听清更彻底，通常对方会换个说法",
     "recommended": false
    },
    {
     "content": "Excusez-moi, vous pouvez parler moins vite ?",
     "zh": "请再说一遍",
     "style": "口语",
     "register": "要求说慢点。法国人语速快，这句实战价值极高",
     "recommended": false
    }
   ],
   "words": [
    {
     "surface": "répéter",
     "zh": "重复"
    },
    {
     "surface": "compris",
     "zh": "理解的（comprendre 的过去分词）"
    }
   ],
   "mistakes": [
    {
     "wrong": "Quoi ?",
     "why": "Quoi 单独用非常粗鲁，等于中文「啥？」，对陌生人绝对不能出口",
     "right": "Comment ? / Pardon ?"
    }
   ],
   "examples": [
    {
     "en": "Comment ? Je n’ai pas entendu.",
     "zh": "什么？我没听见。"
    },
    {
     "en": "Pouvez-vous répéter plus lentement, s’il vous plaît ?",
     "zh": "您能慢一点再说一遍吗？"
    }
   ],
   "note": "法语听力跟不上是常态。最有用的不是「再说一遍」，而是 « moins vite »（慢一点）—— 重复一遍你还是听不懂。",
   "tags": [
    "日常生活",
    "听力"
   ]
  },
